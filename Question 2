import java.io.*;
class ElectricityBillGenerator
{
 public static void main(String args[]) throws IOException
 {
  BufferedReader br=new BufferedReader(new InputStreamReader(System.in));
  String name;
  int number,units;
  double bill;
  System.out.print(" Consumer Name : ");
  name=br.readLine();
  System.out.print(" Consumer Number : ");
  number=Integer.parseInt(br.readLine());
  System.out.print("Enter Units  : ");
  units=Integer.parseInt(br.readLine());
  if(units<=100)
  {
   bill=units*3;
  }
  else if(units<=200)
  {
   bill=(100*3)+(units-100)*5;
  }
  else if(units<=500)
  {
   bill=(100*3)+(100*5)+(units-200)*7;
  }
  else
  {
   bill=(100*3)+(100*5)+(300*7)+(units-500)*10;
  }
  if(bill>5000)
  {
   bill=bill+(bill*0.05);
  }
   System.out.println("\nConsumer Details");
  System.out.println("Name : "+name);
  System.out.println("Consumer Number : "+number);
  System.out.println("Units Consumed : "+units);
  System.out.println("Total Bill  : "+bill);
 }
}

