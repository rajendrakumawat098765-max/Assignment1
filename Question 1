Questionimport java.io.*;
class StudentGradeCalculator
{
 public static void main(String args[]) throws IOException
 {
  BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
  int m1,m2,m3,m4,m5;
  int total;
  double percentage;
  String grade;
  System.out.print(" marks of Subject 1: ");
  m1=Integer.parseInt(br.readLine());
  System.out.print(" marks of Subject 2: ");
  m2=Integer.parseInt(br.readLine());
  System.out.print(" marks of Subject 3: ");
  m3=Integer.parseInt(br.readLine());
  System.out.print(" marks of Subject 4: ");
  m4=Integer.parseInt(br.readLine());
  System.out.print("marks of Subject 5: ");
  m5=Integer.parseInt(br.readLine());
  total=m1+m2+m3+m4+m5;
  percentage=(double)total/500*100;
  if(percentage>=90)
  {
   grade="A+";
  }
  else if(percentage>=80)
  {
   grade="A";
  }
  else if(percentage>=70)
  {
   grade="B";
  }
  else if(percentage>=60)
  {
   grade="C";
  }
  else if(percentage>=50)
  {
   grade="D";
  }
  else
  {
   grade="Fail";
  }
  System.out.println("\n RESULT ");
  System.out.println(" Marks : "+total);
  System.out.println(" percent : "+percentage+"%");
  System.out.println("Grade : "+grade);
  if(percentage>=50)
  {
   System.out.println("Status : PASS");
  }
  else
  {
   System.out.println("Status : FAIL");
  }
 }
}

